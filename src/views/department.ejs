<%- include('partials/header') %>
<main>
    <h1>Course Catalog by Department</h1>
    <p>Browse our available courses and click on any course to see detailed information including available sections and instructors.</p>

    <div class="course-list">
        <% Object.values(departments).forEach(department => { %>
            <div class="course-card">
                <h3><a href="/catalog/<%= department %>"><%= department %></a></h3>
            </div>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>